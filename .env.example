# 复制为 .env 或直接设为环境变量。默认全部关闭。
#
# 视觉判定默认不启用：不配置就等于离线模式，四角/边缘/表面在报告里显示为「—」，
# 不会有任何图片离开本机。

# none = 离线（默认） | deepseek = 云端视觉判定
CARD_VISION_PROVIDER=none

# 仅 CARD_VISION_PROVIDER=deepseek 时需要。不要提交真实 key。
DEEPSEEK_API_KEY=

# deepseek-flash 是当前唯一支持图片输入的模型（deepseek-v4-pro 只支持文本）
CARD_VISION_MODEL=deepseek-flash
CARD_VISION_BASE_URL=https://api.deepseek.com

# 每张分区裁图的边长。官方会把图缩到约 1300x1300 等效，
# 因此 704 已经能保住细节，再大会被丢掉还多花流量。
CARD_VISION_ZONE_SIZE=704

# 送检分区数、并发、超时、重试
CARD_VISION_MAX_ZONES=9
CARD_VISION_CONCURRENCY=4
CARD_VISION_TIMEOUT=60
CARD_VISION_RETRIES=3

# 背面是否也送检（成本翻倍）
CARD_VISION_INCLUDE_BACK=0

# 判定结果缓存目录：同一张图重跑不再产生费用
CARD_VISION_CACHE_DIR=data/cache/vision

# PDF 打印用的浏览器（留空则自动寻找 Chrome / Edge）
# REPORT_BROWSER=C:\Program Files\Google\Chrome\Application\chrome.exe
